# Pocket (required on Vercel)
# Copy to .env.local for local dev. Set same keys in Vercel → Project → Settings → Environment Variables.

# App runtime — Supabase transaction pooler (port 6543) + pgbouncer=true
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations / db push / seed only — session pooler (port 5432), no pgbouncer param
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Production: https://your-app.vercel.app (no trailing slash)
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Legacy RoomGrub UI only (/[room_id]/*) — NOT needed for Pocket (/groups/*)
# NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
