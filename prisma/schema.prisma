generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SplitType {
  EQUAL
  UNEQUAL
}

enum ActivityType {
  EXPENSE_ADDED
  EXPENSE_DELETED
  SETTLEMENT_COMPLETED
  MEMBER_JOINED
  MEMBER_LEFT
  GROUP_CREATED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String        @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at")
  memberships  GroupMember[]
  groupsCreated Group[]      @relation("GroupCreator")
  paidExpenses Expense[]     @relation("ExpensePayer")
  splits       ExpenseSplit[]
  paidSettlements Settlement[] @relation("SettlementPayer")
  receivedSettlements Settlement[] @relation("SettlementReceiver")
  activities   Activity[]

  @@map("users")
}

model Group {
  id         String        @id @default(cuid())
  name       String
  inviteCode String       @unique @map("invite_code")
  createdById String      @map("created_by")
  createdBy  User         @relation("GroupCreator", fields: [createdById], references: [id])
  createdAt  DateTime     @default(now()) @map("created_at")
  members    GroupMember[]
  expenses   Expense[]
  settlements Settlement[]
  activities Activity[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  groupId   String   @map("group_id")
  active    Boolean  @default(true)
  joinedAt  DateTime @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("group_members")
}

model Expense {
  id          String         @id @default(cuid())
  groupId     String         @map("group_id")
  title       String
  totalAmount Int            @map("total_amount")
  paidById    String         @map("paid_by")
  splitType   SplitType      @map("split_type")
  deletedAt   DateTime?      @map("deleted_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy      User           @relation("ExpensePayer", fields: [paidById], references: [id])
  splits      ExpenseSplit[]

  @@index([groupId, deletedAt])
  @@map("expenses")
}

model ExpenseSplit {
  id          String  @id @default(cuid())
  expenseId   String  @map("expense_id")
  userId      String  @map("user_id")
  amountOwed  Int     @map("amount_owed")
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@map("expense_splits")
}

model Settlement {
  id         String   @id @default(cuid())
  groupId    String   @map("group_id")
  payerId    String   @map("payer_id")
  receiverId String   @map("receiver_id")
  amount     Int
  idempotencyKey String? @unique @map("idempotency_key")
  createdAt  DateTime @default(now()) @map("created_at")
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer      User     @relation("SettlementPayer", fields: [payerId], references: [id])
  receiver   User     @relation("SettlementReceiver", fields: [receiverId], references: [id])

  @@index([groupId, createdAt])
  @@map("settlements")
}

model Activity {
  id        String       @id @default(cuid())
  groupId   String       @map("group_id")
  userId    String?      @map("user_id")
  type      ActivityType
  message   String
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id])

  @@index([groupId, createdAt])
  @@map("activities")
}
